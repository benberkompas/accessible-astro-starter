---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  /** The reading time in minutes */
  minutes?: number
}

const { headings, minutes } = Astro.props

const items = headings.filter((h) => h.depth === 2)
---

<nav aria-label="On this page">
  <p class="toc-title">On this page</p>

  <div class="toc-progress" aria-hidden="true">
    <div class="toc-progress-track"><div class="toc-progress-fill"></div></div>
    <span class="toc-progress-label">0%</span>
  </div>

  {minutes && <p class="toc-minutes">{minutes} min read</p>}

  <ul class="list-none">
    {
      items.map((h) => (
        <li class="my-1">
          <a href={`#${h.slug}`} class="text-sm">
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .toc-title {
    font-weight: 600;
  }

  .toc-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.5rem;
    font-size: 0.75rem;
  }

  .toc-progress-track {
    flex: 1;
    border-radius: 2px;
    background: color-mix(in srgb, currentColor 20%, transparent);
    height: 4px;
    overflow: hidden;
  }

  .toc-progress-fill {
    transform: scaleX(0);
    transform-origin: left;
    background: currentColor;
    height: 100%;
  }

  .toc-minutes {
    margin-block: 0 0.75rem;
    font-size: 0.75rem;
  }

  a {
    display: block;
    border-inline-start: 2px solid transparent;
    padding-inline-start: 0.5rem;
  }

  a[aria-current='location'] {
    border-inline-start-color: currentColor;
    font-weight: 600;
  }
</style>

<script>
  let cleanup: (() => void) | null = null

  function init() {
    cleanup?.()
    cleanup = null

    const nav = document.querySelector<HTMLElement>('nav[aria-label="On this page"]')
    if (!nav) return

    const article = document.querySelector<HTMLElement>('[data-article]')
    const fill = nav.querySelector<HTMLElement>('.toc-progress-fill')
    const label = nav.querySelector<HTMLElement>('.toc-progress-label')
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))

    // Pair each link with its heading, in document order
    const targets = links.flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
      return heading ? [{ link, heading }] : []
    })

    const LINE = 0.3 // reference line, as a fraction of viewport height
    let active: HTMLAnchorElement | null = null
    let ticking = false

    function update() {
      ticking = false

      // 1. Progress (runs on every update, before any early return)
      if (article && fill && label) {
        const rect = article.getBoundingClientRect()
        const scrollable = rect.height - window.innerHeight
        const p = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0
        fill.style.transform = `scaleX(${p})`
        label.textContent = `${Math.round(p * 100)}%`
      }

      // 2. Active section highlight
      const line = window.innerHeight * LINE

      let current = null
      for (const t of targets) {
        if (t.heading.getBoundingClientRect().top <= line) current = t
        else break
      }

      // The last section may be too short for its heading to ever reach the line
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
      if (atBottom && targets.length) current = targets[targets.length - 1]

      const next = current ? current.link : null
      if (next === active) return

      active?.removeAttribute('aria-current')
      next?.setAttribute('aria-current', 'location')
      active = next
    }

    function onScroll() {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    update()

    cleanup = () => {
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('resize', onScroll)
    }
  }

  // Fires on the initial load and after every client-side navigation
  document.addEventListener('astro:page-load', init)
  // Detach listeners before the old page is swapped out
  document.addEventListener('astro:before-swap', () => {
    cleanup?.()
    cleanup = null
  })
</script>

---
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'
import { Button } from 'accessible-astro-components'
import { Link } from 'accessible-astro-components'

interface Props {
  headings: MarkdownHeading[]
  /** The reading time in minutes */
  minutes?: number
  /** Visible heading above the list; defaults to "On this page" */
  title?: string
}

type TocItem = MarkdownHeading & { children: MarkdownHeading[] }

const { headings, minutes, title = 'On this page' } = Astro.props

// Group each H3 under the H2 above it (an H3 before any H2 is dropped)
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .reduce<TocItem[]>((acc, h) => {
    if (h.depth === 2) {
      acc.push({ ...h, children: [] })
    } else if (acc.length > 0) {
      acc[acc.length - 1].children.push(h)
    }
    return acc
  }, [])
---

<nav aria-label="On this page">
  <p class="toc-title">{title}</p>

  <div class="toc-progress" aria-hidden="true">
    <div class="toc-progress-track"><div class="toc-progress-fill"></div></div>
    <span class="toc-progress-label">0%</span>
  </div>

  <!-- Show estimated reading time -->
  {
    minutes && (
      <p class="toc-minutes">
        <Icon name="lucide:clock" aria-hidden="true" />
        <span>{minutes} min read</span>
      </p>
    )
  }

  <ul class="list-none">
    {
      items.map((h) => (
        <li class="my-1" data-h2>
          <a href={`#${h.slug}`} class="text-m">
            {h.text}
          </a>
          {h.children.length > 0 && (
            <ul class="toc-sub list-none">
              {h.children.map((sub) => (
                <li class="my-1">
                  <a href={`#${sub.slug}`} class="text-m">
                    {sub.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <!-- Return to top of case study -->
  <!-- <Link href="#top" isButton type="primary" animateOnHover animationType="boop">
    <Icon name="lucide:home" />
    Back to top
  </Link> -->
</nav>

<style>
  @media (max-width: 63.99rem) {
    nav {
      display: none;
    }
  }

  .toc-title {
    font-weight: 600;
  }

  .toc-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.5rem;
    font-size: 0.75rem;
  }

  .toc-progress-track {
    flex: 1;
    border-radius: 2px;
    background: color-mix(in srgb, currentColor 20%, transparent);
    height: 10px;
    overflow: hidden;
  }

  .toc-progress-fill {
    transform: scaleX(0);
    transform-origin: left;
    background: currentColor;
    height: 100%;
  }

  .toc-minutes {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-block: 0 0.75rem;
    font-size: 1rem; /* your value; I'd originally used 0.75rem */
  }

  .toc-minutes :global(svg) {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
  }

  a {
    display: block;
    position: relative;
    opacity: 0.5;
    padding-inline-start: 1rem; /* room for the character */
    /* border-inline-start: 2px solid transparent; */
    /* padding-inline-start: 0.5rem; */
  }

  .toc-sub {
    padding-inline-start: 1rem;
  }

  /* Selected: the current heading */
  a[aria-current='location'] {
    opacity: 1;
    /* border-inline-start-color: currentColor; */
    /* font-weight: 600; */
  }

  a[aria-current='location']::before {
    position: absolute;
    inset-inline-start: 0;
    content: '›';
    content: '›' / ''; /* empty alt text, so screen readers skip it */
  }

  /* H3 lists are hidden only once the script has run, so without JS everything shows */
  nav[data-enhanced] .toc-sub {
    display: none;
  }

  nav[data-enhanced] li[data-expanded] > .toc-sub,
  nav[data-enhanced] li:has(a:focus-visible) > .toc-sub {
    display: block;
  }
</style>

<script>
  let cleanup: (() => void) | null = null

  function init() {
    cleanup?.()
    cleanup = null

    const nav = document.querySelector<HTMLElement>('nav[aria-label="On this page"]')
    if (!nav) return

    // Tells the CSS the script is running, so it's safe to collapse the H3 lists
    nav.setAttribute('data-enhanced', '')

    const article = document.querySelector<HTMLElement>('[data-article]')
    const fill = nav.querySelector<HTMLElement>('.toc-progress-fill')
    const label = nav.querySelector<HTMLElement>('.toc-progress-label')
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))

    // Pair each link with its heading and the top-level (H2) item it belongs to
    const targets = links.flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
      const top = link.closest<HTMLElement>('li[data-h2]')
      return heading && top ? [{ link, heading, top }] : []
    })
    type Target = (typeof targets)[number]

    const LINE = 0.3 // reference line, as a fraction of viewport height
    const SETTLE_MS = 150 // how long scrolling must be still before we call it "settled"

    let activeLink: HTMLAnchorElement | null = null
    let activeTop: HTMLElement | null = null
    let ticking = false

    // After a ToC click, scroll-driven selection is paused.
    // target is the item to keep selected, or null for links like #top that have none.
    let lock: { target: Target | null; settled: boolean; y: number } | null = null
    let settleTimer: number | undefined

    function select(t: Target | null) {
      const nextLink = t ? t.link : null
      if (nextLink === activeLink) return

      activeLink?.removeAttribute('aria-current')
      activeTop?.removeAttribute('data-expanded')

      nextLink?.setAttribute('aria-current', 'location')
      t?.top.setAttribute('data-expanded', '')

      activeLink = nextLink
      activeTop = t ? t.top : null
    }

    function update() {
      ticking = false

      // 1. Progress (always runs)
      if (article && fill && label) {
        const rect = article.getBoundingClientRect()
        const scrollable = rect.height - window.innerHeight
        const p = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0
        fill.style.transform = `scaleX(${p})`
        label.textContent = `${Math.round(p * 100)}%`
      }

      // 2. After a click: don't re-pick headings while the page is scrolling there.
      //    Once it stops, a clicked heading stays selected until the reader scrolls on.
      //    A link with no heading (like #top) just releases the hold and falls through.
      if (lock) {
        if (!lock.settled) return
        if (lock.target && Math.abs(window.scrollY - lock.y) < 2) {
          select(lock.target)
          return
        }
        lock = null
      }

      // 3. Normal rule: the last heading past the reference line
      const line = window.innerHeight * LINE
      let current: Target | null = null
      for (const t of targets) {
        if (t.heading.getBoundingClientRect().top <= line) current = t
        else break
      }

      // 4. At the very bottom, later headings can't reach the line,
      //    so prefer the first heading still in view
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
      if (atBottom) {
        const firstInView = targets.find((t) => {
          const r = t.heading.getBoundingClientRect()
          return r.bottom > 0 && r.top < window.innerHeight
        })
        if (firstInView) current = firstInView
      }

      select(current)
    }

    function armSettle() {
      window.clearTimeout(settleTimer)
      settleTimer = window.setTimeout(() => {
        if (lock) {
          lock.settled = true
          lock.y = window.scrollY
        }
        update()
      }, SETTLE_MS)
    }

    function onScroll() {
      if (lock && !lock.settled) armSettle()
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }

    function onClick(e: MouseEvent) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]')
      if (!link) return

      // A heading link selects its item; any other link (e.g. #top) selects nothing
      const target = targets.find((t) => t.link === link) ?? null

      lock = { target, settled: false, y: 0 }
      select(target)
      armSettle() // covers the case where the click causes no scroll at all
    }

    // If the reader grabs the scroll mid-animation, let go of the hold
    function onUserInput() {
      if (lock && !lock.settled) {
        lock = null
        window.clearTimeout(settleTimer)
        onScroll()
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    window.addEventListener('wheel', onUserInput, { passive: true })
    window.addEventListener('touchstart', onUserInput, { passive: true })
    nav.addEventListener('click', onClick)
    update()

    cleanup = () => {
      window.clearTimeout(settleTimer)
      window.removeEventListener('scroll', onScroll)
      window.removeEventListener('resize', onScroll)
      window.removeEventListener('wheel', onUserInput)
      window.removeEventListener('touchstart', onUserInput)
      nav.removeEventListener('click', onClick)
    }
  }

  // Fires on the initial load and after every client-side navigation
  document.addEventListener('astro:page-load', init)
  // Detach listeners before the old page is swapped out
  document.addEventListener('astro:before-swap', () => {
    cleanup?.()
    cleanup = null
  })
</script>
